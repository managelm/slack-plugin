# Every comment sits on its own line: `docker run --env-file` keeps an inline
# comment as part of the value.

# Slack App credentials (from https://api.slack.com/apps)
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
# Only for Socket Mode (local development). Setting it switches the app to
# Socket Mode, so leave it commented out for an HTTP deployment.
# SLACK_APP_TOKEN=xapp-...

# ManageLM portal
MANAGELM_PORTAL_URL=https://app.managelm.com
MANAGELM_API_KEY=mlm_ak_...

# HTTP port for /slack/events, /webhook and /health. In Socket Mode, Slack
# events use the socket and /webhook and /health still listen on this port.
PORT=3100
# Same secret as on the ManageLM webhook (Settings > MCP & API > Webhooks).
# Without it /webhook rejects every delivery.
MANAGELM_WEBHOOK_SECRET=

# Access control (optional) — comma-separated Slack IDs.
# WARNING: with both unset, anyone in the Slack workspace can use /managelm
# (run tasks, answer them, start scans, search) with the rights of the API
# key's owner.
# Slack user IDs allowed to use the bot, e.g. U0123456789,U0987654321
SLACK_ALLOWED_USERS=
# Channel IDs where commands, the run form and buttons are accepted. Add the
# alert channels for their View Details buttons to work.
SLACK_ALLOWED_CHANNELS=

# Channel routing (optional) — Slack channel IDs. With only one set, every
# event goes there. Invite the app to these channels.
# Warnings and critical events (agent offline, task failed, monitor down, ...)
SLACK_CHANNEL_ALERTS=
# All other events
SLACK_CHANNEL_INFO=

# Portal URL for "View in portal" links
MANAGELM_PORTAL_PUBLIC_URL=https://app.managelm.com
